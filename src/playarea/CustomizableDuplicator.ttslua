DEBUG_MODE = true

--- ==================================================
--- ON LOAD
--- ==================================================

function onLoad()
  self.createButton({
    label = "CUSTOMIZE",
    click_function = "buttonPressed",
    function_owner = self,
    position = { 0, 0.3, -2 },
    rotation = { 0, 0, 0 },
    width = 1800,
    height = 600,
    font_size = 300
  })

  --- Card to copy and customize
  Card1 = nil
  --- Card to read, with upgrades
  Card2 = nil
  --- Optional card, used for investigator image
  Card3 = nil
  invName = nil
end

-- =========================
-- BUTTON
-- =========================

function buttonPressed(obj, playerColor, alt_click)
  -- Cards are sticky. Lock to prevent annoying.
  self.setLock(true)

  detectThreeCards(playerColor)

  boringCommunication()

  if not checkProcess() then return end

  local spawnData = getCardData(Card1)

  if Card1.getName() == "Grizzled" then
    local fieldsInfo = getGrizzledTraits(Card2)
    local nemesisField = getGrizzledNemesis(Card2)
    local alwaysPrepField = getGrizzledAlways(Card2)
    printGrizzledInfo(fieldsInfo, nemesisField, alwaysPrepField)
    spawnGrizzledFromData(spawnData, fieldsInfo, nemesisField, alwaysPrepField, invName, { position = POS_DESTINATION })
  end


  if Card1.getName() == "Runic Axe" or Card1.getName() == "Runic Axe (Taboo)" then
    local thisFields = getRunicAxeUpgrades(Card2)
    printRunicInfo(thisFields)
    spawnRunicFromData(spawnData, thisFields, invName, { position = POS_DESTINATION })
  end

  printToAll("Card duplication complete! Feel free to take the new card.", { 0, 1, 0 })
end

-- =========================
-- DETECTION
-- =========================

function detectThreeCards(player_color)
  if DEBUG_MODE then
    Player[player_color].pingTable(self.positionToWorld(POS1))
    Player[player_color].pingTable(self.positionToWorld(POS2))
    Player[player_color].pingTable(self.positionToWorld(POS3))
  end

  Card1 = detectCard(POS1)
  Card2 = detectCard(POS2)
  Card3 = detectCard(POS3)

  if Card3 and Card3.getName then
    invName = Card3.getName()
  else
    invName = nil
  end
end

function detectCard(position)
  local hits = Physics.cast({
    origin = self.positionToWorld(position) + Vector(0, 1, 0),
    direction = { 0, -1, 0 },
    type = 1,         -- RAY
    max_distance = 5, -- how far down to search
    debug = false
  })
  for _, hit in ipairs(hits) do
    local obj = hit.hit_object
    if obj.getName() == "Card duplicator" then
      return nil
    elseif obj.tag == "Card" then
      return obj
    end
  end

  return nil
end

--- =========================
--- GET CARDS DATA
--- =========================

-- This card gets a lot of info, to be able to spawn a card
---@param card tts__Object: a card
---@return table: a table that can be passed to spawnObject
function getCardData(card)
  if not card then
    error("No card provided", 2)
  end

  if not card.getName or not card.getDescription or not card.getGUID then
    error("Invalid card object", 2)
  end

  if card.tag ~= "Card" then
    error("Object is not a card", 2)
  end

  local data = {}
  data.name = card.getName()
  data.description = card.getDescription()
  data.guid = card.getGUID()
  data.position = card.getPosition()
  data.rotation = card.getRotation()
  data.scale = card.getScale()
  data.gmNotes = card.getGMNotes()
  data.tags = card.getTags()
  data.custom = card.getCustomObject()
  data.luaScript = card.getLuaScript()
  local success, state = pcall(function()
    return card.getLuaScriptState()
  end)
  data.luaScriptState = success and state or ""
  return data
end

-- This takes the Upgrade Sheet of Grizzled, and grabs the traits
function getGrizzledTraits(card)
  if not card or card.script_state == "" then
    return {}
  end

  local data = JSON.decode(card.script_state)
  local allTraits = {}
  if data and data.selections then
    for _, entry in ipairs(data.selections) do
      if entry.text and entry.text ~= "" then
        for trait in string.gmatch(entry.text, "([^,]+)") do
          trait = trait:match("^%s*(.-)%s*$")
          table.insert(allTraits, trait)
        end
      end
    end
  end
  return allTraits
end

---@param card tts__Object
---@return boolean
function getGrizzledNemesis(card)
  local hasNemesis = false
  if not card or card.script_state == "" then
    return false
  end
  pcall(function()
    hasNemesis = JSON.decode(card.script_state).selections[4]["xp"] == 3
  end)

  return hasNemesis
end

---@param card tts__Object
---@return boolean
function getGrizzledAlways(card)
  local hasBool = false
  if not card or card.script_state == "" then
    return false
  end
  pcall(function()
    hasBool = JSON.decode(card.script_state).selections[6]["xp"] == 5
  end)

  return hasBool
end


---@param card tts__Object
---@return table
function getRunicAxeUpgrades(card)
  if not card then
    error("No card provided, implementation error.", 2)
  end

  if card.script_state == "" then
    error("Has no script state, implementation error.", 2)
  end

  local aTable = {
    ["heirloom"] = false,
    ["glory"] = false,
    ["elders"] = false,
    ["hunt"] = false,
    ["fury"] = false,
    ["ancientpower"] = false,
    ["saga"] = false,
    ["scriptweaver"] = false
  }

  if card.getName() ~= "Runic Axe Upgrade Sheet" and card.getName() ~= "Runic Axe Upgrade Sheet (Taboo)" then
    printToAll("Expected Runic Axe Upgrade Sheet, got " .. card.getName())
    return aTable
  end

  local decoded = JSON.decode(card.script_state)
  pcall(function()
    if decoded.selections[1] then aTable["heirloom"] = decoded.selections[1] and decoded.selections[1]["xp"] == 1 end
    if decoded.selections[2] then aTable["glory"] = decoded.selections[2] and decoded.selections[2]["xp"] == 1 end
    if decoded.selections[3] then aTable["elders"] = decoded.selections[3] and decoded.selections[3]["xp"] == 1 end
    if decoded.selections[4] then aTable["hunt"] = decoded.selections[4] and decoded.selections[4]["xp"] == 1 end
    if decoded.selections[5] then aTable["fury"] = decoded.selections[5] and decoded.selections[5]["xp"] == 1 end
    if decoded.selections[6] then aTable["ancientpower"] = decoded.selections[6] and decoded.selections[6]["xp"] == 3 end
    if decoded.selections[7] then aTable["saga"] = decoded.selections[7] and decoded.selections[7]["xp"] == 3 end
    if decoded.selections[8] then aTable["scriptweaver"] = decoded.selections[8] and decoded.selections[8]["xp"] == 4 end
  end)

  if Card2.getName() == "Runic Axe Upgrade Sheet (Taboo)" then
    pcall(function()
      if decoded.selections[4] then
        aTable["hunt"] = decoded.selections[2] and
            decoded.selections[4]["xp"] == 2
      end
    end)
  end

  return aTable
end

function boringCommunication()
  if not Card1 then
    printToAll("No card to stamp detected. Please place a card at the left position.")
  else
    printToAll("Detected card to stamp: " .. Card1.getName())
  end
  if not Card2 then
    printToAll("No card to stamp detected. If you would like, place a card at the central position.")
  else
    printToAll("Detected card to stamp: " .. Card2.getName())
  end

  if Card1 and Card1.getName() == "Grizzled" and not Card3 then
    printToAll("You can place an investigator to customize Grizzled image,  if you want.")
  end
end

--- =========================
--- PRINT
--- =========================

function printGrizzledInfo(fields, nemesisField, alwaysPrepField)
  for _, element in ipairs(fields) do
    printToAll('-    Grizzled has the trait: ' .. element)
  end
  if nemesisField then
    printToAll("-     Nemesis")
  end
  if alwaysPrepField then
    printToAll("-     Always Prepared")
  end
end

function printRunicInfo(fields)
  for key, value in pairs(fields) do
    if value then
      printToAll("-     " .. key)
    end
  end
end

function checkProcess()
  local continue = true
  if not Card1 then
    printToAll("No card to stamp detected. Please place a card at the left position.", 2)
    continue = false
  end

  if Card1.getName() ~= "Grizzled" and Card1.getName() ~= "Runic Axe" and Card1.getName() ~= "Runic Axe (Taboo)" then
    printToAll("Left card must be Grizzled, Runic Axe, or Runic Axe (Taboo). Detected: " .. Card1.getName(), 2)
  end

  if not Card2 then
    printToAll("No Upgrade card to read detected. Place a card at the central position.")
    continue = false
  end

  return continue
end

--- =========================
--- SPAWN CARD
--- =========================

---@param invName string|nil
---@param upgradeFields table
---@param nemesisField boolean
---@param params table
function spawnGrizzledFromData(data, upgradeFields, nemesisField, alwaysPrepField, invName, params)
  if not data or not data.custom then
    error("Invalid card data", 2)
  elseif not upgradeFields or type(upgradeFields) ~= "table" then
    error("Invalid fields data, expected a table", 2)
  elseif type(invName) ~= "string" and invName ~= nil then
    error("Invalid name, expected a string or nil", 2)
  elseif type(nemesisField) ~= "boolean" and nemesisField ~= nil then
    error("Invalid nemesisField, expected bool or nil", 2)
  end

  local destination = self.positionToWorld(params.position)

  local URL = GRIZZLED_INVESTIGATOR_URLS[invName] or GRIZZLED_INVESTIGATOR_URLS["Default"]

  local spawnParams = {
    type = "CardCustom",
    position = destination,
    rotation = data.rotation,
    scale = data.scale,
    sound = false,
    snap_to_grid = false
  }

  local newCard = spawnObject(spawnParams)

  newCard.setCustomObject({
    face = URL,
    back = data.custom.back,
    number = 1,
    back_is_hidden = true
  })

  newCard.setName(data.name)
  newCard.setDescription(data.description)
  newCard.setGMNotes(data.gmNotes)

  for _, tag in ipairs(data.tags or {}) do
    newCard.addTag(tag)
  end


  assert(upgradeFields, "This should exist. april 26")

  setGrizzledScriptWise(newCard, upgradeFields, nemesisField, alwaysPrepField)

  return newCard
end

--- Spawn a Runic Axe with the appropriate image and script
---@param data table
---@param invName string|nil
---@param fieldsBool boolean[]
---@param params table
function spawnRunicFromData(data, fieldsBool, invName, params)
  if not data or not data.custom then
    error("Invalid card data", 2)
  elseif not fieldsBool or type(fieldsBool) ~= "table" then
    error("Invalid fields data, expected a table", 2)
  elseif type(invName) ~= "string" and invName ~= nil then
    error("Invalid name, expected a string or nil", 2)
  end

  local destination = self.positionToWorld(params.position)

  local URL = nil -- INCOMPLETE
  if fieldsBool["glory"] and fieldsBool["hunt"] then
    URL = RUNIC_UPGRADES_URL["gloryhunt"]
  elseif fieldsBool["elders"] and fieldsBool["hunt"] then
    URL = RUNIC_UPGRADES_URL["huntelders"]
  elseif fieldsBool["glory"] then
    URL = RUNIC_UPGRADES_URL["glory"]
  elseif fieldsBool["heirloom"] then
    URL = RUNIC_UPGRADES_URL["heirloom"]
  elseif fieldsBool["elders"] then
    URL = RUNIC_UPGRADES_URL["elders"]
  elseif fieldsBool["hunt"] then
    URL = RUNIC_UPGRADES_URL["hunt"]
  elseif fieldsBool["fury"] then
    URL = RUNIC_UPGRADES_URL["fury"]
  elseif fieldsBool["ancientpower"] then
    URL = RUNIC_UPGRADES_URL["ancientpower"]
  elseif fieldsBool["saga"] then
    URL = RUNIC_UPGRADES_URL["saga"]
  elseif fieldsBool["scriptweaver"] then
    URL = RUNIC_UPGRADES_URL["scriptweaver"]
  else
    URL = RUNIC_UPGRADES_URL["default"]
  end

  local spawnParams = {
    type = "CardCustom",
    position = destination,
    rotation = data.rotation,
    scale = data.scale,
    sound = false,
    snap_to_grid = false
  }
  
  local newCard = spawnObject(spawnParams)

  newCard.setCustomObject({
    face = URL,
    back = data.custom.back,
    number = 1,
    back_is_hidden = true
  })

  newCard.setName(data.name)
  newCard.setDescription(data.description)
  newCard.setGMNotes(data.gmNotes)

  for _, tag in ipairs(data.tags or {}) do
    newCard.addTag(tag)
  end

  setRunicScriptWise(newCard, fieldsBool)
  newCard.reload()

  return newCard
end

--- =========================
--- SET SCRIPT
--- =========================

---@param card tts__Object
---@param alwaysPrepField boolean If true, adds Always Prepared label
function setGrizzledScriptWiseOld(card, ingameTraits, nemesisOuter, alwaysPrepField)
  local posZ = -43
  local posY = 70
  local width = 760
  local height = 100
  local num = #ingameTraits
  local fSize = 48
  
  -- Font and Cell Logic
  if num == 2 then
    fSize = 48
    cellWidth = width / 2
    cellHeight = height
  elseif num == 3 then
    fSize = 32
    cellWidth = width / 3
    cellHeight = height
  else
    fSize = 24
    cellWidth = width / 2
    cellHeight = height / 2
  end

  local function createCell(trait)
    if not trait or trait == "" then return "" end
    return '<Text color="#000000" fontSize="'.. fSize ..'" text="' .. trait .. '" />'
  end

  -- Generate Trait Content
  local xmlContent = ""
  local containerType = ""
  if num == 4 then
    containerType = "GridLayout"
    xmlContent = createCell(ingameTraits[1]) .. createCell(ingameTraits[2]) .. "\n" .. createCell(ingameTraits[3]) .. createCell(ingameTraits[4])
  else
    containerType = "HorizontalLayout"
    local cells = {}
    for _, trait in ipairs(ingameTraits) do table.insert(cells, createCell(trait)) end
    xmlContent = table.concat(cells, "\n")
  end

  -- NEW: Meta-coding for Nemesis and Always Prep
  local extraPanels = ""
  if nemesisOuter then
    extraPanels = extraPanels .. '\n    <Panel position="0 -130 '..posZ..'" rotation="0 0 180" width="760" height="50"><Text color="#0000FF" fontSize="40" text="Nemesis" /></Panel>'
  end
  
  if alwaysPrepField then
    extraPanels = extraPanels .. '\n    <Panel position="0 -115 '..posZ..'" rotation="0 0 180" width="760" height="50"><Text color="#0000FF" fontSize="40" text="Always Prepared" /></Panel>'
  end

  -- Build the final XML Block including the extras
  local xmlBlock = [[<Panel position="-5 ]]..posY.." "..posZ.. [[" rotation="0 0 180" width="760" height="100">
        <]] .. containerType .. [[ spacing="1" cellSize="]] .. cellWidth .. " " .. cellHeight .. [[" scale="0.25 0.25 1">
            ]] .. xmlContent .. [[
        </]] .. containerType .. [[>
    </Panel>]] .. extraPanels

  -- Final Script Generation
  local finalGeneratedCode = [[
xmlStatic = [=[
]] .. xmlBlock .. [[
]=]

function onLoad()
    Wait.frames(function()
        self.UI.setXml(xmlStatic)
    end, 1)
end]]

  card.setLuaScript(finalGeneratedCode)
end

---@param card tts__Object
---@param ingameTraits table A list of traits like Monster, Hazard, Terror
---@param nemesisOuter boolean
---@param alwaysPrepField boolean
function setGrizzledScriptWise(card, ingameTraits, nemesisOuter, alwaysPrepField)
  local posZ = -43
  local posY = 72
  local width = 760
  local height = 100
  local num = #ingameTraits

  -- Logic for cell dimensions and font size
  local fSize = 52
  local cellWidth, cellHeight

  if num == 2 then
    fSize = 48
    cellWidth, cellHeight = width / 2, height
  elseif num == 3 then
    fSize = 36
    cellWidth, cellHeight = width / 3, height
  elseif num == 4 then
    fSize = 28
    cellWidth, cellHeight = width / 2, height / 2
  end

  local function createCell(trait)
    if not trait or trait == "" then return "" end
    return '<Text color="#000000" fontSize="' .. fSize .. '" text="' .. trait .. '" />'
  end

  -- Trait Layout Logic
  local xmlContent = ""
  if num == 4 then
    xmlContent = [[
      <VerticalLayout>
        <HorizontalLayout>]] .. createCell(ingameTraits[1]) .. createCell(ingameTraits[2]) .. [[</HorizontalLayout>
        <HorizontalLayout>]] .. createCell(ingameTraits[3]) .. createCell(ingameTraits[4]) .. [[</HorizontalLayout>
      </VerticalLayout>]]
  else
    local cells = {}
    for _, trait in ipairs(ingameTraits) do table.insert(cells, createCell(trait)) end
    xmlContent = '<HorizontalLayout spacing="1">' .. table.concat(cells, "") .. '</HorizontalLayout>'
  end

  local extraPanels = ""
  if nemesisOuter then
    extraPanels = extraPanels ..
    '\n    <Panel position="0 -115 ' ..
    posZ ..
    '" rotation="0 0 180" width="760" height="100" scale="0.25 0.25 1"><Text color="#0000FF" fontSize="55" text="Nemesis" /></Panel>'
  end

  if alwaysPrepField then
    extraPanels = extraPanels ..
    '\n    <Panel position="0 -100 ' ..
    posZ ..
    '" rotation="0 0 180" width="760" height="100" scale="0.25 0.25 1"><Text color="#0000FF" fontSize="55" text="Always Prepared" /></Panel>'
  end

  local xmlBlock = [[<Panel position="-5 ]] ..
  posY .. " " .. posZ .. [[" rotation="0 0 180" width="760" height="100" scale="0.25 0.25 1">
        ]] .. xmlContent .. [[
    </Panel>]] .. extraPanels

  local finalGeneratedCode = "xmlStatic = [=[" .. xmlBlock .. "]=]\n\n" .. [[
function onLoad()
    Wait.frames(function()
        self.UI.setXml(xmlStatic)
    end, 1)
end]]

  card.setLuaScript(finalGeneratedCode)
end

---@param card tts__Object
---@param params table A table with boolean fields: saga, scriptweaver, ancientpower
function setRunicScriptWise(card, params)
  local posX = 0
  local posZ = -43
  local width = 760
  local height = 100

  local additionalXml = ""
  local initXml = '<Panel rotation="0 0 180" scale = "0.25 0.25 1" width="'
  local initXml2 = width .. '" height="' .. height .. '" position="' .. posX .. ' '
  local initXml3 = 'fontSize="36" rectAlignment="MiddleCenter" />'

  if params.saga then
    additionalXml = additionalXml ..
        initXml ..
        width .. '" height="' .. height .. '" position="' .. -70 .. ' ' .. 30 ..
        ' ' .. posZ .. '">'..
        '<Text text="Saga&#10;(replenish 2)" ' .. ' color="#000000" ' ..
        initXml3 ..
        '</Panel>'
  end
  if params.scriptweaver then
    additionalXml = additionalXml ..
        initXml ..
        initXml2 .. 130 ..
        ' ' .. posZ .. '">' ..
        '<Text text="Scriptweaver (You may imbue 2 per charge)" ' .. ' color="#ffffff" ' ..
        initXml3 ..
        '</Panel>'
  end
  if params.ancientpower then
    additionalXml = additionalXml ..
        initXml ..
        initXml2 .. 150 ..
        ' ' .. posZ .. '">' ..
        '<Text text="Ancient Power (may imbue up to 3)" ' .. ' color="#ffffff" '  ..
        initXml3 ..
        '</Panel>'
  end
  

  local cardScript = [[
  -- Generated Script

local globalFontSize = 10

local staticXml = ']] .. additionalXml .. [['

function onLoad()
  -- Wait a frame to ensure UI is ready
  Wait.frames(function() self.UI.setXml(staticXml) end, 1)
end
  ]]

  card.setLuaScript(cardScript)
end
