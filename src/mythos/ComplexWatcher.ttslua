local BLUE_TREACHERY = { r = 0.300, g = 0.700, b = 0.800 }
local BLUE_ENEMY = { r = 0.267, g = 0.667, b = 0.731 }

function onLoad(savedData)
  self.interactable = true
  lastPhase = nil
  newPhase = nil
  enemyDecalActive = true

  function toggleEnemyDecal(playerColor)
    enemyDecalActive = not enemyDecalActive
    local status = enemyDecalActive and "enabled" or "disabled"
    printToAll("Enemy decal " .. status, playerColor)
  end

  -- Add context menu option
  self.addContextMenuItem("Toggle Enemy Decal", toggleEnemyDecal)
end

---@param aString string
function respondToChange(aString)
  assert(type(aString) == "string", "Error type")
  -- This function is called from outside
  newPhase = aString

  if newPhase == lastPhase then
    return
  end

  lastPhase = newPhase

  if newPhase == "1.9" then
    placeEnemyDecalsWisely()
  elseif newPhase == "2.9" then
    placeEnemyDecalsWisely()
  elseif newPhase == "3.3" then
    showEnemyMovement()
  elseif newPhase == "3.7" then
    showEnemyAttack()
  end

  showAllCardsInfo(lastPhase)
end

-- Show things, according to phase number

---@param phaseString string
function showAllCardsInfo(phaseString)
  local colorPrint = nil
  local slightRed = { r = 0.8, g = 0.2, b = 0.2 }
  local slightGreen = { r = 0.531, g = 0.848, b = 0.598 }

  if phaseString == "1.1" then
    colorPrint = slightRed
  elseif phaseString == "1.9" then
    colorPrint = slightRed
  elseif phaseString == "2.1" then
    colorPrint = slightGreen
  elseif phaseString == "2.9" then
    colorPrint = slightGreen
  elseif phaseString == "3.1" then
    colorPrint = BLUE_ENEMY
  elseif phaseString == "3.9" then
    colorPrint = Color.Blue
  elseif phaseString == "4.1" then
    colorPrint = Color.Yellow
  elseif phaseString == "4.9" then
    colorPrint = Color.Yellow
  end
  showAllMythosInfo({ phaseNumber = phaseString, colorPrint = colorPrint })
  showAllEnemyInfo({ phaseNumber = phaseString, colorPrint = colorPrint })
  showAllTreacheryInfo({ phaseNumber = phaseString, colorPrint = colorPrint })
  showAllLocationInfo({ phaseNumber = phaseString, colorPrint = colorPrint })
end

function showAllMythosInfo(params)
  local phaseNumber = params.phaseNumber
  local colorPrint = params.colorPrint

  local mythosObjects = EnemyWatcherApi.getVisibleCardsMythosArea()

  for _, object in ipairs(mythosObjects) do
    local msg = getMythosMessage(object, phaseNumber)
    if msg then
      printToAll(msg, colorPrint)
    end
  end
end

function showAllEnemyInfo(params)
  local phaseNumber = params.phaseNumber
  local colorPrint = params.colorPrint

  -- Retrieve objects in play area
  local enemiesInPlayArea = EnemyWatcherApi.getEnemiesInPlayArea()
  -- Retrieve objects in threat area
  local enemiesInThreatAreas = EnemyWatcherApi.getEnemiesInThreatAreas()

  for _, enemy in ipairs(enemiesInPlayArea) do
    local msg = getEnemyMessage(enemy, phaseNumber)
    if msg then
      printToAll(msg, colorPrint)
      EnemyWatcherApi.highlightObjects({ enemy }, colorPrint, 10)
    end
  end

  for _, enemy in ipairs(enemiesInThreatAreas) do
    local msg = getEnemyMessage(enemy, phaseNumber)
    if msg then
      printToAll(msg, colorPrint)
      EnemyWatcherApi.highlightObjects({ enemy }, colorPrint, 10)
    end
  end
end

function showAllTreacheryInfo(params)
  local phaseNumber = params.phaseNumber
  local colorPrint = params.colorPrint

  -- Retrieve objects in play area
  local treacheriesInPlayArea = EnemyWatcherApi.getTreacheriesInPlayArea()
  -- Retrieve objects in threat area
  local treacheriesInThreatAreas = EnemyWatcherApi.getTreacheriesInThreatAreas()

  for _, enemy in ipairs(treacheriesInPlayArea) do
    local msg = getTreacheryMessage(enemy, phaseNumber)
    if msg then
      printToAll(msg, colorPrint)
      EnemyWatcherApi.highlightObjects({ enemy }, colorPrint, 10)
    end
  end

  for _, enemy in ipairs(treacheriesInThreatAreas) do
    local msg = getTreacheryMessage(enemy, phaseNumber)
    if msg then
      printToAll(msg, colorPrint)
      EnemyWatcherApi.highlightObjects({ enemy }, colorPrint, 10)
    end
  end
end

function showAllLocationInfo(params)
  local phaseNumber = params.phaseNumber
  local colorPrint = params.colorPrint

  -- Retrieve objects in play area
  local locations = EnemyWatcherApi.getLocationsFaceup()

  for _, localization in ipairs(locations) do
    local msg = getLocationMessage(localization, phaseNumber, true)
    if msg then
      printToAll(msg, colorPrint)
      EnemyWatcherApi.highlightObjects({ localization }, colorPrint, 10)
    end
  end

  local locationsFaceDown = EnemyWatcherApi.getLocationsFacedown()
  for _, localization in ipairs(locations) do
    local msg = getLocationMessage(localization, phaseNumber, false)
    if msg then
      printToAll(msg, colorPrint)
      EnemyWatcherApi.highlightObjects({ localization }, colorPrint, 10)
    end
  end
end

-- 333333333333333333
--  GET
-- 333333333333333333

function getHunterEnemiesInMap()
  local enemies = EnemyWatcherApi.getEnemiesInPlayArea()
  local hunters = {}
  for _, enemy in ipairs(enemies) do
    local rawNotes = enemy.getGMNotes() or "{}"
    local md = JSON.decode(rawNotes) or {}
    local id = md['id'] or ''
    if hunterEnemies[id] then
      table.insert(hunters, enemy)
    end
  end

  return hunters
end

function getPatrolEnemiesInMap()
  local enemies = EnemyWatcherApi.getEnemiesInPlayArea()
  local aloofs = {}
  for _, enemy in ipairs(enemies) do
    local rawNotes = enemy.getGMNotes() or "{}"
    local md = JSON.decode(rawNotes) or {}
    local id = md['id'] or ''
    if PATROL_ENEMIES[id] then
      table.insert(aloofs, enemy)
    end
  end
  return aloofs
end

function getMassiveEnemiesInMap()
  local enemies = EnemyWatcherApi.getEnemiesInPlayArea()
  local massives = {}
  for _, enemy in ipairs(enemies) do
    local rawNotes = enemy.getGMNotes() or "{}"
    local md = JSON.decode(rawNotes) or {}
    local id = md['id'] or ''
    if MASSIVE_ENEMIES[id] then
      table.insert(massives, enemy)
    end
  end
  return massives
end

function showEnemyMovement()
  local hunters = getHunterEnemiesInMap()
  local numHunter = #hunters
  local patrols = getPatrolEnemiesInMap()
  local numPatrol = #patrols
  local numColor = "[ffaaaa]" .. tostring(numHunter) .. "[-]"
  log(numHunter)
  log(numPatrol)
  if numHunter>0 or numPatrol >0 then
    printToAll("Hunter and patrol (ready and unengaged) enemies move.", LIGHT_BLUE)
  end

  if numHunter > 0 then
    printToAll("There are " .. numColor .. " enemies with hunter.", LIGHT_BLUE)
  elseif numPatrol == 1 then
    printToAll("There is " .. numColor .. " enemy with hunter.", LIGHT_BLUE)
  end
  local numColor = "[ffaaaa]" .. tostring(numPatrol) .. "[-]"
  if numPatrol > 2 then
    printToAll("There are" .. numColor .. " enemies with patrol.", LIGHT_BLUE)
  elseif numPatrol == 1 then
    printToAll("There is " .. numColor .. " enemy with patrol.", LIGHT_BLUE)
  end
end

function showEnemyAttack()
  local massive = getMassiveEnemiesInMap()
  local numMassive = #massive
  local numColor = "[ffaaaa]" .. tostring(numMassive) .. "[-]"
  if numMassive > 0 then
    printToAll("There are " .. numColor .. " massive enemies in the map.")
  end
end

-- Place Decals

function placeEnemyDecalsWisely()
  if enemyDecalActive == false then
    return
  end

  -- get all enemies in the map and threat areas
  local enemies = EnemyWatcherApi.getEnemiesInPlayArea()

  local adding = EnemyWatcherApi.getEnemiesInThreatAreas()

  -- Merge threat area enemies
  local initialCount = #enemies
  for _, v in ipairs(adding) do
    table.insert(enemies, v)
  end

  -- Process each enemy
  for i, enemy in ipairs(enemies) do
    -- Get GM notes
    local rawNotes = enemy.getGMNotes() or "{}"

    -- Decode JSON
    local md = JSON.decode(rawNotes) or {}
    local id = md['id'] or ''

    -- Check and apply decals
    if MASSIVE_ENEMIES[id] then
      DecalPlacerApi.placeDecal(enemy, 'massiveEnemy')
    end

    if MASSIVE_ENEMIES_FLIPPED[id] then
      DecalPlacerApi.placeDecal(enemy, 'massiveEnemyFlipped')
    end

    if AgendaMassiveEnemiesFlipped[id] then
      DecalPlacerApi.placeDecal(enemy, 'massiveEnemyFlipped')
    end

    if hunterEnemies[id] then
      DecalPlacerApi.placeDecal(enemy, 'hunterEnemy')
    end

    if HunterEnemiesFlipped[id] then
      DecalPlacerApi.placeDecal(enemy, 'hunterEnemyFlipped')
    end

    if AgendaHunterEnemiesFlipped[id] then
      DecalPlacerApi.placeDecal(enemy, 'hunterEnemyFlipped')
    end

    if ALOOF_ENEMIES[id] then
      DecalPlacerApi.placeDecal(enemy, 'aloofEnemy')
    end

    if id == '' or id == nil then
      log("Enemy " .. i .. " has no ID in GM notes")
    elseif not (MASSIVE_ENEMIES[id] or MASSIVE_ENEMIES_FLIPPED[id] or AgendaMassiveEnemiesFlipped[id] or
          hunterEnemies[id] or HunterEnemiesFlipped[id] or AgendaHunterEnemiesFlipped[id] or
          ALOOF_ENEMIES[id]) then
    end
  end
end

function placeLocationDecalsWisely()
  local locations = EnemyWatcherApi.getLocationsFaceup()
  for _, location in ipairs(locations) do
    local rawNotes = location.getGMNotes() or "{}"
    local md = JSON.decode(rawNotes) or {}
    local id = md['id'] or ''
    if LocationsBlockedBack[id] then
      DecalPlacerApi.placeDecal(location, 'blockedLocation')
    end
  end
end

-- Message retrieval

--- @param obj userdata|table  TTS object or decoded metadata table
--- @param phaseNumber number   Phase index used to select the message
--- @return string|nil
function getTreacheryMessage(obj, phaseNumber)
  -- Returns string or nil
  local rawNotes = obj.getGMNotes() or "{}"
  local md = JSON.decode(rawNotes) or {}
  local id = md['id'] or ''
  local messages = TreacheryMessage[id] or nil
  if messages then
    return messages[phaseNumber] or nil
  end
  return nil
end

--- @param obj userdata|table  TTS object or decoded metadata table
--- @param phaseNumber number   Phase index used to select the message
--- @return string|nil
function getMythosMessage(obj, phaseNumber)
  local rawNotes = "{}"
  local md = {}
  local id = ""

  if type(obj) == "userdata" then
    rawNotes = obj.getGMNotes() or "{}"
    md = JSON.decode(rawNotes) or {}
    id = md.id or ""
  elseif type(obj) == "table" then
    md = obj or {}
    id = md.id or ""
  else
    error("Unsupported card type for ID extraction", 2)
  end

  local messages = MythosMessage[id] or nil
  if messages then
    return messages[phaseNumber]
  end
end

function getEnemyMessage(obj, phaseNumber)
  -- Returns string or nil
  local rawNotes = obj.getGMNotes() or "{}"
  local md = JSON.decode(rawNotes) or {}
  local id = md['id'] or ''
  local messages = EnemyMessage[id] or nil
  if messages then
    return messages[phaseNumber] or nil
  end
  return nil
end

--- @param obj tts__Object
--- @param phaseNumber number  Phase index used to select the message
--- @param isFaceUp boolean
--- @return string|nil
function getLocationMessage(obj, phaseNumber, isFaceUp)
  if not obj or type(obj) ~= "userdata" then
    error("Invalid object provided to getLocationMessage", 2)
    return nil
  elseif type(phaseNumber) ~= "string" then
    error("Invalid phaseNumber provided to getLocationMessage", 2)
    return nil
  elseif type(isFaceUp) ~= "boolean" then
    error("Invalid isFaceUp provided to getLocationMessage", 2)
    return nil
  end

  local rawNotes = obj.getGMNotes() or "{}"
  local md = JSON.decode(rawNotes) or {}
  local id = md['id'] or ''
  local messages = nil
  if isFaceUp then
    messages = LocationFaceupMessage[id] or nil
  elseif isFaceUp == false then
    messages = LocationFacedownMessage[id] or nil
  end

  if messages then
    return messages[phaseNumber] or nil
  end
end
